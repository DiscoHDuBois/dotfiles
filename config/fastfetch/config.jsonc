{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "~/.config/fastfetch/lain.png",
    "width": 30,
    "padding": {
      "top": 1,
      "left": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "",
      "output": "white"
    },
    "percent": {
      "type": 1
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "{#90}╭─────────────────────────────────────────────╮"
    },
    {
      "type": "os",
      "key": "{#90}│ {#94} {#94}OS        ",
      "format": "{#}{name} {version-id<4}{arch<13}{#90} │"
    },
    {
      "type": "kernel",
      "key": "{#90}│ {#94} {#94}Kernel    ",
      "format": "{#}{release<30}{#90} │"
    },
    {
      "type": "packages",
      "key": "{#90}│ {#94}󰏖 {#94}Packages  ",
      "format": "{#}{all<30}{#90} │"
    },
    {
      "type": "display",
      "key": "{#90}│ {#94}󰍹 {#94}Display   ",
      "format": "{#}{width}x{height}  {refresh-rate>3} Hz             {#90} │"
    },
    {
      "type": "wm",
      "key": "{#90}│ {#94} {#94}WM        ",
      "format": "{#}{pretty-name<30}{#90} │"
    },
    {
      "type": "terminal",
      "key": "{#90}│ {#94} {#94}Terminal  ",
      "format": "{#}{pretty-name<30}{#90} │"
    },
    {
      "type": "custom",
      "format": "{#90}╰─────────────────────────────────────────────╯"
    },
    "break",
    {
      "type": "custom",
      "format": "{#90}╭─────────────────────────────────────────────╮"
    },
    {
      "type": "cpu",
      "key": "{#90}│ {#94} {#94}CPU       ",
      "format": "{#}{name<30}{#90} │"
    },
    {
      "type": "gpu",
      "key": "{#90}│ {#94}󰢮 {#94}GPU       ",
      "format": "{#}{name<30}{#90} │"
    },
    {
      "type": "memory",
      "key": "{#90}│ {#94}󰍛 {#94}Memory    ",
      "format": "{#}{used>9} / {total<9} {percentage>5}   {#90} │"
    },
    {
      "type": "custom",
      "format": "{#90}╰─────────────────────────────────────────────╯"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    }
  ]
}